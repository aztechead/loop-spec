{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/aztechead/loop-spec/graph/schema.json",
  "title": "loop-spec workflow graph",
  "type": "object",
  "required": ["nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "entry": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      ]
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/definitions/edge" }
    }
  },
  "definitions": {
    "stateKey": {
      "type": "string",
      "enum": [
        "schemaVersion",
        "slug",
        "feature_title",
        "createdAt",
        "updatedAt",
        "execStyle",
        "executionProfile",
        "phaseHandoff",
        "currentPhase",
        "completedPhases",
        "branch",
        "worktreePath",
        "executionRootMode",
        "baseSha",
        "baseBranch",
        "models",
        "phaseModels",
        "artifacts",
        "currentTeamName",
        "currentTeammates",
        "currentGate",
        "commands",
        "workspace",
        "stalenessHours",
        "prUrl",
        "checkpointPrUrl",
        "delivery",
        "verificationBaseline",
        "warnings",
        "mergeQueue",
        "pendingRemediationTasks",
        "bootstrapPendingDomains",
        "activeWorkflow",
        "harnessTaskMetadataMode",
        "harnessStatusMode",
        "fileConflictExcludeGlobs",
        "gateHistory"
      ]
    },
    "effort": {
      "type": "string",
      "enum": ["system1", "system2"]
    },
    "routeCondition": {
      "type": "object",
      "required": ["probe", "args", "expects"],
      "additionalProperties": false,
      "properties": {
        "probe": {
          "type": "string",
          "minLength": 1,
          "description": "Repo-relative path to an executable probe script"
        },
        "args": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Probe argument vector. {featureDir}, {repoRoot}, {featureRepoRoot}, {slug}, {node}, {baseSha} are engine-substituted placeholders; no other placeholder is legal. May be empty."
        },
        "expects": {
          "type": "string",
          "pattern": "^[^|]+$",
          "description": "Exact expected probe answer token. No '|' alternation -- declare separate edges instead."
        }
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "kind", "reads", "writes", "effort"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Short human-facing name used in step descriptors and graph readers"
        },
        "kind": {
          "type": "string",
          "enum": ["agent", "function", "gate", "human", "subgraph"]
        },
        "reads": {
          "type": "array",
          "items": { "$ref": "#/definitions/stateKey" }
        },
        "writes": {
          "type": "array",
          "items": { "$ref": "#/definitions/stateKey" }
        },
        "optionalReads": {
          "type": "array",
          "items": { "$ref": "#/definitions/stateKey" },
          "description": "State keys the node consults but that are legitimately absent or null (an opt-out the schema documents, e.g. verificationBaseline without LOOP_SPEC_STARTUP_BASELINE=1). Entering the node never asserts them; the body owns the null case. A key may appear in reads or optionalReads, never both."
        },
        "effort": { "$ref": "#/definitions/effort" },
        "body": { "type": "string" },
        "bodyArgs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Argument vector passed to a function/gate body. {featureDir}, {repoRoot}, {featureRepoRoot}, {slug}, {node}, {baseSha} are engine-substituted placeholders; no other placeholder is legal. Absent means the body is invoked with no arguments."
        },
        "graph": { "type": "string" },
        "authorizesDelivery": { "type": "boolean" },
        "admit": {
          "$ref": "#/definitions/routeCondition",
          "description": "Human-node pause gate (contract sec 4): admitted on entry writes a checkpoint and pauses; not admitted (including unresolved) skips the node. Only a human node may declare it."
        },
        "routeDefault": {
          "type": "string",
          "minLength": 1,
          "description": "Node id to take when this node has route edges and none is satisfied. Absent means no-route is an abort, never a silent chain fallthrough (contract sec 3)."
        }
      }
    },
    "loopEdge": {
      "type": "object",
      "required": ["from", "to", "kind", "ceiling", "strategy"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "kind": { "const": "loop" },
        "ceiling": { "type": "number", "exclusiveMinimum": 0 },
        "strategy": { "type": "string", "enum": ["unroll", "contain"] }
      }
    },
    "edge": {
      "type": "object",
      "required": ["from", "to", "kind"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["chain", "route", "fanout", "fanin", "loop"]
        },
        "condition": { "$ref": "#/definitions/routeCondition" },
        "join": { "type": "string" },
        "ceiling": { "type": "number", "exclusiveMinimum": 0 },
        "strategy": { "type": "string", "enum": ["unroll", "contain"] }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "route" } }, "required": ["kind"] },
          "then": { "required": ["condition"] }
        },
        {
          "if": { "properties": { "kind": { "const": "fanin" } }, "required": ["kind"] },
          "then": { "required": ["join"] }
        },
        {
          "if": { "properties": { "kind": { "const": "loop" } }, "required": ["kind"] },
          "then": { "required": ["ceiling", "strategy"] }
        }
      ]
    }
  }
}
