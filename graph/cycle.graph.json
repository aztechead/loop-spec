{
  "id": "cycle",
  "entry": "spec",
  "nodes": [
    {
      "id": "spec",
      "label": "Write the specification",
      "kind": "agent",
      "reads": [
        "slug",
        "feature_title",
        "execStyle"
      ],
      "writes": [
        "artifacts",
        "currentPhase",
        "warnings"
      ],
      "effort": "system2",
      "body": "skills/spec/SKILL.md"
    },
    {
      "id": "human.after-spec",
      "label": "Review the specification",
      "kind": "human",
      "reads": [
        "execStyle",
        "phaseHandoff"
      ],
      "writes": [
        "currentPhase"
      ],
      "effort": "system1",
      "admit": {
        "probe": "lib/graph/probes/human-gate.sh",
        "args": [
          "--feature-dir",
          "{featureDir}"
        ],
        "expects": "gate=pause"
      },
      "routeDefault": "discuss"
    },
    {
      "id": "discuss",
      "label": "Challenge and refine the specification",
      "kind": "agent",
      "reads": [
        "artifacts",
        "execStyle",
        "bootstrapPendingDomains"
      ],
      "writes": [
        "artifacts",
        "currentPhase",
        "warnings"
      ],
      "effort": "system2",
      "body": "skills/discuss/SKILL.md"
    },
    {
      "id": "discuss.critique.gate",
      "label": "Check whether the spec needs critique",
      "kind": "gate",
      "reads": [
        "artifacts"
      ],
      "writes": [
        "currentGate"
      ],
      "effort": "system1",
      "routeDefault": "discuss.critique"
    },
    {
      "id": "discuss.critique",
      "label": "Run the specification critique",
      "kind": "subgraph",
      "reads": [
        "artifacts",
        "currentGate"
      ],
      "writes": [
        "artifacts",
        "currentGate",
        "gateHistory"
      ],
      "effort": "system2",
      "graph": "graph/critique.graph.json"
    },
    {
      "id": "human.after-discuss",
      "label": "Review the refined specification",
      "kind": "human",
      "reads": [
        "execStyle",
        "phaseHandoff"
      ],
      "writes": [
        "currentPhase"
      ],
      "effort": "system1",
      "admit": {
        "probe": "lib/graph/probes/human-gate.sh",
        "args": [
          "--feature-dir",
          "{featureDir}"
        ],
        "expects": "gate=pause"
      }
    },
    {
      "id": "plan",
      "label": "Plan the implementation",
      "kind": "agent",
      "reads": [
        "artifacts",
        "commands",
        "warnings"
      ],
      "writes": [
        "artifacts",
        "currentPhase",
        "warnings"
      ],
      "effort": "system2",
      "body": "skills/plan/SKILL.md"
    },
    {
      "id": "plan.critique.gate",
      "label": "Check whether the plan needs critique",
      "kind": "gate",
      "reads": [
        "artifacts"
      ],
      "writes": [
        "currentGate"
      ],
      "effort": "system1",
      "body": "plan-critique-fastpath"
    },
    {
      "id": "plan.critique",
      "label": "Run the plan critique",
      "kind": "subgraph",
      "reads": [
        "artifacts",
        "currentGate"
      ],
      "writes": [
        "artifacts",
        "currentGate",
        "gateHistory"
      ],
      "effort": "system2",
      "graph": "graph/critique.graph.json"
    },
    {
      "id": "human.after-plan",
      "label": "Review the implementation plan",
      "kind": "human",
      "reads": [
        "execStyle",
        "phaseHandoff"
      ],
      "writes": [
        "currentPhase"
      ],
      "effort": "system1",
      "admit": {
        "probe": "lib/graph/probes/human-gate.sh",
        "args": [
          "--feature-dir",
          "{featureDir}"
        ],
        "expects": "gate=pause"
      }
    },
    {
      "id": "execute",
      "label": "Execute the plan",
      "kind": "agent",
      "reads": [
        "artifacts",
        "commands",
        "pendingRemediationTasks",
        "mergeQueue",
        "branch"
      ],
      "writes": [
        "artifacts",
        "currentPhase",
        "mergeQueue",
        "pendingRemediationTasks",
        "currentTeammates"
      ],
      "effort": "system2",
      "body": "skills/execute/SKILL.md"
    },
    {
      "id": "execute.worker",
      "label": "Implement one task",
      "kind": "agent",
      "reads": [
        "artifacts",
        "commands",
        "branch"
      ],
      "writes": [
        "mergeQueue"
      ],
      "effort": "system2",
      "body": "loop-spec:implementer"
    },
    {
      "id": "execute.join",
      "label": "Integrate one completed task",
      "kind": "function",
      "reads": [
        "mergeQueue"
      ],
      "writes": [
        "mergeQueue",
        "currentPhase"
      ],
      "effort": "system1",
      "body": "lib/integrate-task.sh"
    },
    {
      "id": "human.after-execute",
      "label": "Review the implementation",
      "kind": "human",
      "reads": [
        "execStyle",
        "phaseHandoff"
      ],
      "writes": [
        "currentPhase"
      ],
      "effort": "system1",
      "admit": {
        "probe": "lib/graph/probes/human-gate.sh",
        "args": [
          "--feature-dir",
          "{featureDir}"
        ],
        "expects": "gate=pause"
      }
    },
    {
      "id": "verify",
      "label": "Verify the integrated change",
      "kind": "agent",
      "reads": [
        "artifacts",
        "commands"
      ],
      "optionalReads": [
        "verificationBaseline"
      ],
      "writes": [
        "artifacts",
        "currentPhase",
        "pendingRemediationTasks",
        "warnings"
      ],
      "effort": "system2",
      "body": "skills/verify/SKILL.md"
    },
    {
      "id": "verify.marker",
      "label": "Reject unresolved placeholders",
      "kind": "gate",
      "reads": [
        "artifacts"
      ],
      "writes": [
        "warnings"
      ],
      "effort": "system1",
      "body": "lib/placeholder-scan.sh",
      "bodyArgs": [
        "{baseSha}",
        "{featureRepoRoot}"
      ]
    },
    {
      "id": "verify.tamper",
      "label": "Reject weakened tests",
      "kind": "gate",
      "reads": [
        "artifacts",
        "commands"
      ],
      "writes": [
        "warnings"
      ],
      "effort": "system1",
      "body": "lib/test-tamper-scan.sh",
      "bodyArgs": [
        "{baseSha}",
        "{featureRepoRoot}"
      ]
    },
    {
      "id": "verify.acceptance",
      "label": "Check acceptance evidence",
      "kind": "gate",
      "reads": [
        "artifacts"
      ],
      "writes": [
        "warnings"
      ],
      "effort": "system2",
      "body": "lib/acceptance-lint.sh",
      "bodyArgs": [
        "{featureDir}/tasks.json"
      ],
      "routeDefault": "verify.code-review"
    },
    {
      "id": "verify.code-review",
      "label": "Review code quality",
      "kind": "gate",
      "reads": [
        "artifacts",
        "branch"
      ],
      "writes": [
        "warnings",
        "pendingRemediationTasks"
      ],
      "effort": "system2",
      "body": "loop-spec:code-reviewer"
    },
    {
      "id": "iterate",
      "label": "Judge the result against the goal",
      "kind": "agent",
      "reads": [
        "artifacts",
        "feature_title",
        "execStyle"
      ],
      "writes": [
        "artifacts",
        "currentPhase",
        "warnings",
        "pendingRemediationTasks"
      ],
      "effort": "system2",
      "body": "skills/iterate/SKILL.md"
    },
    {
      "id": "human.iterate-spec-approval",
      "label": "Approve a specification rewind",
      "kind": "human",
      "reads": [
        "execStyle"
      ],
      "writes": [
        "currentPhase",
        "warnings"
      ],
      "effort": "system1",
      "admit": {
        "probe": "lib/graph/probes/human-gate.sh",
        "args": [
          "--feature-dir",
          "{featureDir}"
        ],
        "expects": "gate=pause"
      }
    },
    {
      "id": "deliver",
      "label": "Deliver the verified change",
      "kind": "agent",
      "reads": [
        "artifacts",
        "branch",
        "baseBranch",
        "delivery"
      ],
      "writes": [
        "delivery",
        "currentPhase",
        "prUrl",
        "warnings"
      ],
      "effort": "system2",
      "authorizesDelivery": true,
      "body": "skills/deliver/SKILL.md"
    },
    {
      "id": "completed",
      "label": "Publish the terminal result",
      "kind": "function",
      "reads": [
        "delivery",
        "currentPhase"
      ],
      "writes": [
        "currentPhase"
      ],
      "effort": "system1",
      "body": "lib/cycle-result.sh"
    }
  ],
  "edges": [
    {
      "from": "spec",
      "to": "human.after-spec",
      "kind": "chain"
    },
    {
      "from": "human.after-spec",
      "to": "discuss",
      "kind": "route",
      "condition": {
        "probe": "lib/graph/probes/short-path.sh",
        "args": [
          "--feature-dir",
          "{featureDir}"
        ],
        "expects": "path=full"
      }
    },
    {
      "from": "human.after-spec",
      "to": "plan",
      "kind": "route",
      "condition": {
        "probe": "lib/graph/probes/short-path.sh",
        "args": [
          "--feature-dir",
          "{featureDir}"
        ],
        "expects": "path=short"
      }
    },
    {
      "from": "discuss",
      "to": "discuss.critique.gate",
      "kind": "chain"
    },
    {
      "from": "discuss.critique.gate",
      "to": "discuss.critique",
      "kind": "route",
      "condition": {
        "probe": "lib/graph/probes/short-path.sh",
        "args": [
          "--feature-dir",
          "{featureDir}"
        ],
        "expects": "path=full"
      }
    },
    {
      "from": "discuss.critique.gate",
      "to": "human.after-discuss",
      "kind": "route",
      "condition": {
        "probe": "lib/graph/probes/short-path.sh",
        "args": [
          "--feature-dir",
          "{featureDir}"
        ],
        "expects": "path=short"
      }
    },
    {
      "from": "discuss.critique",
      "to": "human.after-discuss",
      "kind": "chain"
    },
    {
      "from": "human.after-discuss",
      "to": "plan",
      "kind": "chain"
    },
    {
      "from": "plan",
      "to": "plan.critique.gate",
      "kind": "chain"
    },
    {
      "from": "plan.critique.gate",
      "to": "plan.critique",
      "kind": "route",
      "condition": {
        "probe": "lib/graph/probes/plan-critique.sh",
        "args": [
          "--feature-dir",
          "{featureDir}"
        ],
        "expects": "signal=matched"
      }
    },
    {
      "from": "plan.critique.gate",
      "to": "human.after-plan",
      "kind": "route",
      "condition": {
        "probe": "lib/graph/probes/plan-critique.sh",
        "args": [
          "--feature-dir",
          "{featureDir}"
        ],
        "expects": "signal=none"
      }
    },
    {
      "from": "plan.critique",
      "to": "human.after-plan",
      "kind": "chain"
    },
    {
      "from": "human.after-plan",
      "to": "execute",
      "kind": "chain"
    },
    {
      "from": "execute",
      "to": "execute.worker",
      "kind": "fanout"
    },
    {
      "from": "execute.worker",
      "to": "execute.join",
      "kind": "fanin",
      "join": "merge-queue"
    },
    {
      "from": "execute.join",
      "to": "execute.worker",
      "kind": "loop",
      "ceiling": 2,
      "strategy": "unroll"
    },
    {
      "from": "execute.join",
      "to": "human.after-execute",
      "kind": "chain"
    },
    {
      "from": "human.after-execute",
      "to": "verify",
      "kind": "chain"
    },
    {
      "from": "verify",
      "to": "verify.marker",
      "kind": "chain"
    },
    {
      "from": "verify.marker",
      "to": "verify.tamper",
      "kind": "chain"
    },
    {
      "from": "verify.tamper",
      "to": "verify.acceptance",
      "kind": "chain"
    },
    {
      "from": "verify.acceptance",
      "to": "verify.code-review",
      "kind": "route",
      "condition": {
        "probe": "lib/graph/probes/short-path.sh",
        "args": [
          "--feature-dir",
          "{featureDir}"
        ],
        "expects": "path=full"
      }
    },
    {
      "from": "verify.acceptance",
      "to": "iterate",
      "kind": "route",
      "condition": {
        "probe": "lib/graph/probes/short-path.sh",
        "args": [
          "--feature-dir",
          "{featureDir}"
        ],
        "expects": "path=short"
      }
    },
    {
      "from": "verify.code-review",
      "to": "iterate",
      "kind": "chain"
    },
    {
      "from": "iterate",
      "to": "human.iterate-spec-approval",
      "kind": "route",
      "condition": {
        "probe": "lib/graph/probes/iterate-approval.sh",
        "args": [
          "--feature-dir",
          "{featureDir}"
        ],
        "expects": "approval=required"
      }
    },
    {
      "from": "iterate",
      "to": "execute",
      "kind": "route",
      "condition": {
        "probe": "lib/graph/probes/iterate-gap.sh",
        "args": [
          "--feature-dir",
          "{featureDir}"
        ],
        "expects": "gap=execute"
      }
    },
    {
      "from": "iterate",
      "to": "plan",
      "kind": "route",
      "condition": {
        "probe": "lib/graph/probes/iterate-gap.sh",
        "args": [
          "--feature-dir",
          "{featureDir}"
        ],
        "expects": "gap=plan"
      }
    },
    {
      "from": "iterate",
      "to": "discuss",
      "kind": "route",
      "condition": {
        "probe": "lib/graph/probes/iterate-gap.sh",
        "args": [
          "--feature-dir",
          "{featureDir}"
        ],
        "expects": "gap=spec"
      }
    },
    {
      "from": "iterate",
      "to": "deliver",
      "kind": "route",
      "condition": {
        "probe": "lib/graph/probes/iterate-gap.sh",
        "args": [
          "--feature-dir",
          "{featureDir}"
        ],
        "expects": "gap=none"
      }
    },
    {
      "from": "human.iterate-spec-approval",
      "to": "discuss",
      "kind": "chain"
    },
    {
      "from": "iterate",
      "to": "execute",
      "kind": "loop",
      "ceiling": 10,
      "strategy": "contain"
    },
    {
      "from": "iterate",
      "to": "plan",
      "kind": "loop",
      "ceiling": 10,
      "strategy": "contain"
    },
    {
      "from": "iterate",
      "to": "discuss",
      "kind": "loop",
      "ceiling": 10,
      "strategy": "contain"
    },
    {
      "from": "iterate",
      "to": "human.iterate-spec-approval",
      "kind": "loop",
      "ceiling": 10,
      "strategy": "contain"
    },
    {
      "from": "iterate",
      "to": "verify",
      "kind": "loop",
      "ceiling": 10,
      "note": "ITERATE convergence round budget; mirrors feature.iterate.maxIterations (lib/feature-init.sh:234)",
      "strategy": "unroll"
    },
    {
      "from": "deliver",
      "to": "execute",
      "kind": "route",
      "condition": {
        "probe": "lib/graph/probes/deliver-next.sh",
        "args": [
          "--feature-dir",
          "{featureDir}"
        ],
        "expects": "nextPhase=execute"
      }
    },
    {
      "from": "deliver",
      "to": "execute",
      "kind": "loop",
      "ceiling": 2,
      "strategy": "unroll"
    },
    {
      "from": "deliver",
      "to": "completed",
      "kind": "route",
      "condition": {
        "probe": "lib/graph/probes/deliver-next.sh",
        "args": [
          "--feature-dir",
          "{featureDir}"
        ],
        "expects": "nextPhase=completed"
      }
    },
    {
      "from": "deliver",
      "to": "deliver",
      "kind": "route",
      "condition": {
        "probe": "lib/graph/probes/deliver-next.sh",
        "args": [
          "--feature-dir",
          "{featureDir}"
        ],
        "expects": "nextPhase=deliver"
      },
      "note": "transport/identity/check-oracle failure: retry delivery, bounded, rather than claiming completion"
    },
    {
      "from": "deliver",
      "to": "deliver",
      "kind": "loop",
      "ceiling": 2,
      "strategy": "unroll",
      "note": "bounds the delivery retry; exhausting it aborts resumably instead of looping forever"
    }
  ]
}
