{
  "id": "cycle",
  "entry": "spec",
  "nodes": [
    {
      "id": "spec",
      "skill": "spec-lite",
      "label": "Write the specification",
      "kind": "agent",
      "reads": [
        "slug",
        "feature_title",
        "execStyle"
      ],
      "writes": [
        "artifacts",
        "currentPhase",
        "warnings",
        "specApproval"
      ],
      "effort": "system2",
      "body": "skills/spec/SKILL.md",
      "ingress": {
        "fields": [
          "slug",
          "feature_title",
          "execStyle",
          "greenfield",
          "autonomous",
          "artifacts.spec"
        ],
        "optional": [
          "{featureDir}/spec-draft.md",
          "{featureDir}/decisions.jsonl"
        ]
      },
      "egress": {
        "misplaced": "SPEC.md",
        "gates": [
          {
            "label": "artifact-lint",
            "body": "lib/artifact-lint.sh",
            "args": [
              "spec",
              "{docs}/SPEC.md"
            ]
          },
          {
            "label": "oneshot-shape",
            "body": "lib/oneshot-spec-lint.sh",
            "args": [
              "{docs}/SPEC.md"
            ]
          }
        ],
        "oracle": true,
        "writes": [
          "artifacts.spec",
          "specApproval"
        ],
        "artifacts": {
          "spec": "{docs}/SPEC.md"
        },
        "commit": {
          "message": "spec: {slug}",
          "paths": [
            "{docs}/SPEC.md",
            "{docs}/EVIDENCE.md"
          ]
        },
        "close": "always"
      }
    },
    {
      "id": "human.after-spec",
      "label": "Review the specification",
      "kind": "human",
      "reads": [
        "execStyle"
      ],
      "writes": [
        "currentPhase"
      ],
      "effort": "system1",
      "admit": {
        "probe": "lib/graph/probes/human-gate.sh",
        "args": [
          "--feature-dir",
          "{featureDir}"
        ],
        "expects": "gate=pause"
      },
      "routeDefault": "discuss"
    },
    {
      "id": "oneshot",
      "label": "Implement the small change in one pass",
      "kind": "agent",
      "reads": [
        "artifacts",
        "commands",
        "branch"
      ],
      "writes": [
        "artifacts",
        "currentPhase",
        "warnings"
      ],
      "effort": "system2",
      "body": "skills/oneshot/SKILL.md",
      "ingress": {
        "fields": [
          "slug",
          "feature_title",
          "execStyle",
          "autonomous",
          "branch",
          "baseSha",
          "commands",
          "artifacts.spec",
          "models.codeReviewer"
        ],
        "required": [
          {
            "writer": "SPEC",
            "path": "{docs}/SPEC.md"
          }
        ],
        "skeletons": [
          {
            "path": "{docs}/VERIFICATION.md",
            "template": "skills/shared/artifact-templates/VERIFICATION-oneshot.md.template"
          }
        ]
      },
      "egress": {
        "misplaced": "VERIFICATION.md",
        "gates": [
          {
            "label": "oneshot",
            "body": "lib/oneshot-exit-gate.sh",
            "args": [
              "{featureDir}"
            ]
          }
        ],
        "writes": [
          "artifacts.spec",
          "artifacts.verification"
        ],
        "artifactsIfPresent": {
          "verification": "{docs}/VERIFICATION.md"
        },
        "commit": {
          "message": "oneshot: {slug}",
          "paths": [
            "{docs}/SPEC.md",
            "{docs}/VERIFICATION.md",
            "{docs}/EVIDENCE.md"
          ]
        },
        "checkpoint": "post-oneshot",
        "close": "always"
      }
    },
    {
      "id": "discuss",
      "label": "Challenge and refine the specification",
      "kind": "agent",
      "reads": [
        "artifacts",
        "execStyle"
      ],
      "writes": [
        "artifacts",
        "currentPhase",
        "warnings"
      ],
      "effort": "system2",
      "body": "skills/discuss/SKILL.md",
      "ingress": {
        "fields": [
          "slug",
          "feature_title",
          "execStyle",
          "autonomous",
          "iterate.feedback",
          "currentGate"
        ],
        "required": [
          {
            "writer": "SPEC",
            "path": "{docs}/SPEC.md"
          }
        ]
      },
      "egress": {
        "misplaced": "SPEC.md",
        "gates": [
          {
            "label": "artifact-lint",
            "body": "lib/artifact-lint.sh",
            "args": [
              "spec",
              "{docs}/SPEC.md"
            ]
          },
          {
            "label": "grounding-lint",
            "body": "lib/grounding-lint.sh",
            "args": [
              "{docs}/SPEC.md"
            ]
          }
        ],
        "oracle": true,
        "writes": [
          "artifacts.spec",
          "artifacts.patternsPrefetch"
        ],
        "artifacts": {
          "spec": "{docs}/SPEC.md"
        },
        "commit": {
          "message": "spec: {slug}",
          "paths": [
            "{docs}/SPEC.md",
            "{docs}/EVIDENCE.md"
          ]
        },
        "checkpoint": "post-discuss",
        "close": "always"
      }
    },
    {
      "id": "discuss.critique.gate",
      "label": "Check whether the spec needs critique",
      "kind": "gate",
      "reads": [
        "artifacts"
      ],
      "writes": [
        "currentGate"
      ],
      "effort": "system1",
      "routeDefault": "discuss.critique"
    },
    {
      "id": "discuss.critique",
      "label": "Run the specification critique",
      "kind": "subgraph",
      "reads": [
        "artifacts",
        "currentGate"
      ],
      "writes": [
        "artifacts",
        "currentGate",
        "gateHistory"
      ],
      "effort": "system2",
      "graph": "graph/critique.graph.json"
    },
    {
      "id": "human.after-discuss",
      "label": "Review the refined specification",
      "kind": "human",
      "reads": [
        "execStyle"
      ],
      "writes": [
        "currentPhase"
      ],
      "effort": "system1",
      "admit": {
        "probe": "lib/graph/probes/human-gate.sh",
        "args": [
          "--feature-dir",
          "{featureDir}"
        ],
        "expects": "gate=pause"
      }
    },
    {
      "id": "plan",
      "label": "Plan the implementation",
      "kind": "agent",
      "reads": [
        "artifacts",
        "commands",
        "warnings"
      ],
      "writes": [
        "artifacts",
        "currentPhase",
        "warnings"
      ],
      "effort": "system2",
      "body": "skills/plan/SKILL.md",
      "ingress": {
        "fields": [
          "slug",
          "greenfield",
          "workspace",
          "iterate.feedback",
          "currentGate",
          "artifacts",
          "models.planner",
          "models.challenger"
        ],
        "required": [
          {
            "writer": "SPEC",
            "path": "{docs}/SPEC.md"
          }
        ],
        "optional": [
          "{docs}/PATTERNS.md",
          "{docs}/EVIDENCE.md"
        ]
      },
      "egress": {
        "misplaced": "PLAN.md",
        "gates": [
          {
            "label": "plan",
            "body": "lib/plan-exit-gate.sh",
            "args": [
              "{featureDir}"
            ]
          },
          {
            "label": "decision-coverage",
            "body": "lib/decision-coverage.sh",
            "args": [
              "{spec}",
              "{docs}/PLAN.md"
            ]
          },
          {
            "label": "criteria-coverage",
            "body": "lib/criteria-coverage.sh",
            "args": [
              "{spec}",
              "{docs}/PLAN.md"
            ]
          },
          {
            "label": "grounding-lint",
            "body": "lib/grounding-lint.sh",
            "args": [
              "{docs}/PLAN.md"
            ]
          }
        ],
        "writes": [
          "artifacts.patternsPrefetch",
          "artifacts.patternsSource",
          "artifacts.patterns",
          "artifacts.plan",
          "artifacts.tasks"
        ],
        "artifacts": {
          "plan": "{docs}/PLAN.md",
          "patterns": "{docs}/PATTERNS.md",
          "tasks": "{featureDir}/tasks.json"
        },
        "artifactsDefault": {
          "patternsSource": "pattern-mapper"
        },
        "commit": {
          "message": "plan: {slug}",
          "paths": [
            "{docs}/PLAN.md",
            "{docs}/PATTERNS.md",
            "{docs}/EVIDENCE.md"
          ]
        },
        "checkpoint": "post-plan",
        "close": "always"
      }
    },
    {
      "id": "plan.critique.gate",
      "label": "Check whether the plan needs critique",
      "kind": "gate",
      "routeDefault": "plan.critique",
      "reads": [
        "artifacts"
      ],
      "writes": [
        "currentGate"
      ],
      "effort": "system1",
      "body": "plan-critique-fastpath"
    },
    {
      "id": "plan.critique",
      "label": "Run the plan critique",
      "kind": "subgraph",
      "reads": [
        "artifacts",
        "currentGate"
      ],
      "writes": [
        "artifacts",
        "currentGate",
        "gateHistory"
      ],
      "effort": "system2",
      "graph": "graph/critique.graph.json"
    },
    {
      "id": "human.after-plan",
      "label": "Review the implementation plan",
      "kind": "human",
      "reads": [
        "execStyle"
      ],
      "writes": [
        "currentPhase"
      ],
      "effort": "system1",
      "admit": {
        "probe": "lib/graph/probes/human-gate.sh",
        "args": [
          "--feature-dir",
          "{featureDir}"
        ],
        "expects": "gate=pause"
      }
    },
    {
      "id": "execute",
      "label": "Execute the plan",
      "kind": "agent",
      "reads": [
        "artifacts",
        "commands",
        "pendingRemediationTasks",
        "mergeQueue",
        "branch"
      ],
      "writes": [
        "artifacts",
        "currentPhase",
        "mergeQueue",
        "pendingRemediationTasks",
        "currentTeammates"
      ],
      "effort": "system2",
      "body": "skills/execute/SKILL.md",
      "routeDefault": "human.after-execute",
      "ingress": {
        "fields": [
          "slug",
          "branch",
          "baseSha",
          "commands",
          "workspace",
          "executionRootMode",
          "worktreePath",
          "greenfield",
          "artifacts.tasks",
          "pendingRemediationTasks",
          "models.implementer",
          "models.specComplianceReviewer"
        ],
        "required": [
          {
            "writer": "PLAN",
            "path": "{tasks}"
          },
          {
            "writer": "PLAN",
            "path": "{docs}/PLAN.md"
          }
        ],
        "optional": [
          "{docs}/PATTERNS.md"
        ]
      },
      "egress": {
        "gates": [
          {
            "label": "execute",
            "body": "lib/execute-exit-gate.sh",
            "args": [
              "check",
              "{featureDir}"
            ]
          }
        ],
        "writes": [
          "mergeQueue",
          "pendingRemediationTasks",
          "commands",
          "greenfield",
          "artifacts.tasks",
          "artifacts.execution",
          "artifacts.remediationReceipt",
          "workspace"
        ],
        "onOk": [
          {
            "label": "commit-strategy",
            "body": "lib/execute-exit-gate.sh",
            "args": [
              "finish",
              "{featureDir}"
            ]
          }
        ],
        "checkpoint": "post-execute",
        "set": {
          "mergeQueue": [],
          "pendingRemediationTasks": []
        },
        "close": "always"
      }
    },
    {
      "id": "execute.worker",
      "label": "Implement one task",
      "kind": "agent",
      "reads": [
        "artifacts",
        "commands",
        "branch"
      ],
      "writes": [
        "mergeQueue"
      ],
      "effort": "system2",
      "body": "loop-spec:implementer"
    },
    {
      "id": "execute.join",
      "label": "Integrate one completed task",
      "kind": "function",
      "reads": [
        "mergeQueue"
      ],
      "writes": [
        "mergeQueue",
        "currentPhase"
      ],
      "effort": "system1",
      "body": "lib/integrate-task.sh"
    },
    {
      "id": "human.after-execute",
      "label": "Review the implementation",
      "kind": "human",
      "reads": [
        "execStyle"
      ],
      "writes": [
        "currentPhase"
      ],
      "effort": "system1",
      "admit": {
        "probe": "lib/graph/probes/human-gate.sh",
        "args": [
          "--feature-dir",
          "{featureDir}"
        ],
        "expects": "gate=pause"
      }
    },
    {
      "id": "verify",
      "label": "Verify the integrated change",
      "kind": "agent",
      "reads": [
        "artifacts",
        "commands"
      ],
      "optionalReads": [
        "verificationBaseline"
      ],
      "writes": [
        "artifacts",
        "currentPhase",
        "pendingRemediationTasks",
        "warnings"
      ],
      "effort": "system2",
      "body": "skills/verify/SKILL.md",
      "ingress": {
        "fields": [
          "slug",
          "baseSha",
          "branch",
          "commands",
          "workspace",
          "artifacts.spec",
          "artifacts.plan",
          "models.verifier",
          "models.codeReviewer"
        ],
        "required": [
          {
            "writer": "SPEC",
            "path": "{docs}/SPEC.md"
          },
          {
            "writer": "PLAN",
            "path": "{docs}/PLAN.md"
          }
        ]
      },
      "egress": {
        "misplaced": "VERIFICATION.md",
        "gates": [
          {
            "label": "artifact-lint",
            "body": "lib/artifact-lint.sh",
            "args": [
              "verification",
              "{docs}/VERIFICATION.md"
            ]
          },
          {
            "label": "verification-grounding",
            "body": "lib/verification-grounding-lint.sh",
            "args": [
              "{docs}/VERIFICATION.md",
              "--repo",
              "{root}",
              "--spec",
              "{spec}"
            ]
          },
          {
            "label": "review-triage",
            "body": "lib/review-triage-lint.sh",
            "args": [
              "{docs}/VERIFICATION.md"
            ]
          },
          {
            "label": "acceptance-table",
            "body": "lib/converged-floor.sh",
            "args": [
              "--shape",
              "{spec}",
              "{docs}/VERIFICATION.md"
            ]
          }
        ],
        "writes": [
          "pendingRemediationTasks",
          "artifacts.verification",
          "artifacts.reviewOrder",
          "verificationBaseline",
          "workspace"
        ],
        "artifacts": {
          "verification": "{docs}/VERIFICATION.md"
        },
        "artifactsIfPresent": {
          "reviewOrder": "{docs}/REVIEW-ORDER.md"
        },
        "commit": {
          "message": "verify: {slug}",
          "paths": [
            "{docs}/VERIFICATION.md",
            "{docs}/REVIEW-ORDER.md",
            "{docs}/EVIDENCE.md"
          ]
        },
        "checkpoint": "post-verify",
        "close": "always"
      }
    },
    {
      "id": "verify.placeholder.gate",
      "label": "Check whether the placeholder scan is required",
      "kind": "gate",
      "reads": [
        "artifacts"
      ],
      "writes": [
        "currentGate"
      ],
      "effort": "system1"
    },
    {
      "id": "verify.marker",
      "label": "Reject unresolved placeholders",
      "kind": "gate",
      "reads": [
        "artifacts"
      ],
      "writes": [
        "warnings"
      ],
      "effort": "system1",
      "body": "lib/feature-scan-each.sh",
      "bodyArgs": [
        "{repoRoot}/lib/placeholder-scan.sh",
        "--feature-dir",
        "{featureDir}"
      ]
    },
    {
      "id": "verify.tamper.gate",
      "label": "Check whether the tamper scan is required",
      "kind": "gate",
      "reads": [
        "artifacts",
        "commands"
      ],
      "writes": [
        "currentGate"
      ],
      "effort": "system1"
    },
    {
      "id": "verify.tamper",
      "label": "Reject weakened tests",
      "kind": "gate",
      "reads": [
        "artifacts",
        "commands"
      ],
      "writes": [
        "warnings"
      ],
      "effort": "system1",
      "body": "lib/feature-scan-each.sh",
      "bodyArgs": [
        "{repoRoot}/lib/test-tamper-scan.sh",
        "--feature-dir",
        "{featureDir}"
      ]
    },
    {
      "id": "verify.acceptance.gate",
      "label": "Check whether acceptance evidence is required",
      "kind": "gate",
      "reads": [
        "artifacts"
      ],
      "writes": [
        "currentGate"
      ],
      "effort": "system1"
    },
    {
      "id": "verify.acceptance",
      "label": "Check acceptance evidence",
      "kind": "gate",
      "reads": [
        "artifacts"
      ],
      "writes": [
        "warnings"
      ],
      "effort": "system2",
      "body": "lib/acceptance-lint.sh",
      "bodyArgs": [
        "{featureDir}/tasks.json"
      ],
      "routeDefault": "verify.code-review"
    },
    {
      "id": "verify.code-review.gate",
      "label": "Check whether code review is required",
      "kind": "gate",
      "reads": [
        "artifacts",
        "branch"
      ],
      "writes": [
        "currentGate"
      ],
      "effort": "system1",
      "routeDefault": "verify.code-review"
    },
    {
      "id": "verify.code-review",
      "label": "Review code quality",
      "kind": "gate",
      "reads": [
        "artifacts",
        "branch"
      ],
      "writes": [
        "warnings",
        "pendingRemediationTasks"
      ],
      "effort": "system2",
      "body": "loop-spec:code-reviewer"
    },
    {
      "id": "iterate.gate",
      "label": "Check whether result judgment is required",
      "kind": "gate",
      "reads": [
        "artifacts"
      ],
      "writes": [
        "currentGate"
      ],
      "effort": "system1",
      "routeDefault": "iterate"
    },
    {
      "id": "iterate",
      "label": "Judge the result against the goal",
      "kind": "agent",
      "reads": [
        "artifacts",
        "feature_title",
        "execStyle"
      ],
      "writes": [
        "artifacts",
        "currentPhase",
        "warnings",
        "pendingRemediationTasks"
      ],
      "effort": "system2",
      "body": "skills/iterate/SKILL.md",
      "ingress": {
        "fields": [
          "slug",
          "feature_title",
          "execStyle",
          "autonomous",
          "backlogEntryId",
          "iterate",
          "artifacts",
          "models.iterateJudge"
        ],
        "required": [
          {
            "writer": "SPEC",
            "path": "{docs}/SPEC.md"
          },
          {
            "writer": "VERIFY",
            "path": "{docs}/VERIFICATION.md"
          }
        ]
      },
      "egress": {
        "required": [
          {
            "label": "iteration",
            "path": "{docs}/ITERATION.md"
          }
        ],
        "gates": [
          {
            "label": "converged-floor",
            "body": "lib/converged-floor.sh",
            "args": [
              "{spec}",
              "{docs}/VERIFICATION.md"
            ],
            "when": {
              "field": "iterate.lastVerdict.converged",
              "equals": "true"
            }
          }
        ],
        "writes": [
          "iterate",
          "artifacts.iteration",
          "pendingRemediationTasks",
          "backlogEntryId"
        ],
        "artifacts": {
          "iteration": "{docs}/ITERATION.md"
        },
        "commit": {
          "message": "iterate: {slug} iteration {f:iterate.used}",
          "paths": [
            "{docs}/ITERATION.md",
            ".loop-spec/BACKLOG.md"
          ]
        },
        "close": "terminal"
      }
    },
    {
      "id": "human.iterate-spec-approval",
      "label": "Approve a specification rewind",
      "kind": "human",
      "reads": [
        "execStyle"
      ],
      "writes": [
        "currentPhase",
        "warnings"
      ],
      "effort": "system1",
      "admit": {
        "probe": "lib/graph/probes/human-gate.sh",
        "args": [
          "--feature-dir",
          "{featureDir}"
        ],
        "expects": "gate=pause"
      }
    },
    {
      "id": "deliver",
      "label": "Deliver the verified change",
      "kind": "agent",
      "reads": [
        "artifacts",
        "branch",
        "baseBranch",
        "delivery"
      ],
      "writes": [
        "delivery",
        "currentPhase",
        "prUrl",
        "warnings"
      ],
      "effort": "system2",
      "authorizesDelivery": true,
      "body": "skills/deliver/SKILL.md",
      "ingress": {
        "fields": [
          "slug",
          "branch",
          "baseBranch",
          "workspace",
          "artifacts"
        ],
        "optional": [
          "{featureDir}/delivery.json"
        ]
      }
    },
    {
      "id": "completed",
      "label": "Publish the terminal result",
      "kind": "function",
      "reads": [
        "delivery",
        "currentPhase"
      ],
      "writes": [
        "currentPhase"
      ],
      "effort": "system1",
      "body": "lib/cycle-result.sh"
    }
  ],
  "edges": [
    {
      "from": "oneshot",
      "to": "oneshot",
      "kind": "route",
      "condition": {
        "probe": "lib/graph/probes/review-route.sh",
        "args": [
          "--feature-dir",
          "{featureDir}"
        ],
        "expects": "review=bad-spec"
      }
    },
    {
      "from": "verify",
      "to": "discuss",
      "kind": "route",
      "condition": {
        "probe": "lib/graph/probes/review-route.sh",
        "args": [
          "--feature-dir",
          "{featureDir}"
        ],
        "expects": "review=bad-spec"
      }
    },
    {
      "from": "verify",
      "to": "execute",
      "kind": "route",
      "condition": {
        "probe": "lib/graph/probes/review-route.sh",
        "args": [
          "--feature-dir",
          "{featureDir}"
        ],
        "expects": "review=remediate"
      }
    },
    {
      "from": "verify",
      "to": "execute",
      "kind": "loop",
      "ceiling": 5,
      "strategy": "contain"
    },
    {
      "from": "spec",
      "to": "human.after-spec",
      "kind": "chain"
    },
    {
      "from": "human.after-spec",
      "to": "oneshot",
      "kind": "route",
      "condition": {
        "probe": "lib/graph/probes/oneshot.sh",
        "args": [
          "--feature-dir",
          "{featureDir}"
        ],
        "expects": "route=oneshot"
      },
      "sameSession": true
    },
    {
      "from": "human.after-spec",
