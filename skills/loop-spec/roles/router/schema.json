{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "router result: one entry for the request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entry",
    "pr",
    "reason"
  ],
  "properties": {
    "entry": {
      "type": "string",
      "minLength": 1
    },
    "pr": {
      "type": [
        "integer",
        "null"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  }
}
