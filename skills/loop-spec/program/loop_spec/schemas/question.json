{
  "type": "object",
  "required": ["questionId", "attempt", "phase", "text", "options", "defaultValue", "kind", "payload", "askedAt"],
  "additionalProperties": false,
  "properties": {
    "questionId": {"type": "string"},
    "attempt": {"type": "string"},
    "phase": {"type": "string"},
    "text": {"type": "string", "minLength": 1},
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["value", "label"],
        "additionalProperties": false,
        "properties": {
          "value": {"type": "string"},
          "label": {"type": "string"}
        }
      }
    },
    "defaultValue": {"type": ["string", "null"]},
    "kind": {"type": "string", "enum": ["approval", "choice", "text", "blocked"]},
    "payload": {"type": ["object", "null"]},
    "askedAt": {"type": "string"}
  }
}
