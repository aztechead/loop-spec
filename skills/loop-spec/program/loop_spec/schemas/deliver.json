{
  "type": "object",
  "required": [
    "exit",
    "inputsDigest",
    "boundTo",
    "repos"
  ],
  "additionalProperties": false,
  "properties": {
    "exit": {
      "type": "string",
      "enum": [
        "delivered",
        "partially delivered",
        "delivery blocked"
      ]
    },
    "inputsDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "boundTo": {
      "type": "object",
      "required": [
        "requirements",
        "plan"
      ],
      "additionalProperties": false,
      "properties": {
        "requirements": {
          "type": [
            "string",
            "null"
          ]
        },
        "plan": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "repos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "repo",
          "pr",
          "deliveredSha",
          "caveats",
          "state"
        ],
        "additionalProperties": false,
        "properties": {
          "repo": {
            "type": "string"
          },
          "pr": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "number",
                  "url",
                  "headRef",
                  "headSha",
                  "base"
                ],
                "additionalProperties": false,
                "properties": {
                  "number": {
                    "type": "integer"
                  },
                  "url": {
                    "type": "string"
                  },
                  "headRef": {
                    "type": "string"
                  },
                  "headSha": {
                    "type": "string"
                  },
                  "base": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "deliveredSha": {
            "type": [
              "string",
              "null"
            ]
          },
          "caveats": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "state": {
            "type": "string",
            "enum": [
              "delivered",
              "failed",
              "skipped"
            ]
          }
        }
      }
    }
  }
}
