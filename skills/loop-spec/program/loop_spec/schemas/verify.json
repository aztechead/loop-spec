{
  "type": "object",
  "required": [
    "exit",
    "inputsDigest",
    "boundTo",
    "verdicts",
    "findings",
    "remediationTasks",
    "reviewedRange"
  ],
  "additionalProperties": false,
  "$defs": {
    "finding": {
      "type": "object",
      "required": [
        "id",
        "location",
        "cause",
        "severity",
        "disposition",
        "reason",
        "supersedes"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "cause": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "Critical",
            "Important",
            "Minor"
          ]
        },
        "disposition": {
          "type": "string",
          "enum": [
            "fixed",
            "rejected",
            "deferred",
            "open"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "supersedes": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "kind",
                "id"
              ],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "finding",
                    "range"
                  ]
                },
                "id": {
                  "type": "string"
                }
              }
            }
          ]
        }
      }
    },
    "planTask": {
      "type": "object",
      "required": [
        "id",
        "title",
        "dependsOn",
        "files",
        "repo",
        "verify",
        "criteria",
        "featureAdded",
        "mustFlip"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[TR]-[0-9]+$"
        },
        "title": {
          "type": "string"
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "repo": {
          "type": "string"
        },
        "verify": {
          "type": "string"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "featureAdded": {
          "type": [
            "string",
            "null"
          ],
          "description": "A target file PATH that does not exist at base, never a command. null for a task whose verify target already exists at base."
        },
        "mustFlip": {
          "type": "boolean",
          "description": "true only for a debug repair task whose verify command is the failing reproduction; false for every ordinary task."
        }
      }
    }
  },
  "properties": {
    "exit": {
      "type": "string",
      "enum": [
        "passed",
        "implementation gap",
        "plan gap",
        "intent gap",
        "evidence incomplete",
        "blocked"
      ]
    },
    "inputsDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "boundTo": {
      "type": "object",
      "required": [
        "requirements",
        "plan"
      ],
      "additionalProperties": false,
      "properties": {
        "requirements": {
          "type": [
            "string",
            "null"
          ]
        },
        "plan": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "criterion",
          "verdict",
          "evidence",
          "cause"
        ],
        "additionalProperties": false,
        "properties": {
          "criterion": {
            "type": "string"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "blocked"
            ]
          },
          "evidence": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "command",
                  "sha",
                  "exitStatus",
                  "failureIdentities",
                  "outputDigest"
                ],
                "additionalProperties": false,
                "properties": {
                  "command": {
                    "type": "string"
                  },
                  "sha": {
                    "type": "string"
                  },
                  "exitStatus": {
                    "type": "integer"
                  },
                  "failureIdentities": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "outputDigest": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "cause": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "remediationTasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/planTask"
      }
    },
    "reviewedRange": {
      "type": "object",
      "required": [
        "from",
        "to",
        "full"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "full": {
          "type": "boolean"
        }
      }
    }
  }
}
