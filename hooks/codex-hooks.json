{
  "description": "loop-spec Codex lifecycle hooks. Plugin-bundled; skipped until trusted.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/codex-session-start.sh\"",
            "statusMessage": "loop-spec session start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/codex-user-prompt.sh\"",
            "statusMessage": "loop-spec done-criteria"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/codex-shell-env.sh\"",
            "statusMessage": "loop-spec shell env"
          }
        ]
      },
      {
        "matcher": "Bash|Agent|apply_patch|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "LOOP_SPEC_HARNESS=codex python3 \"${PLUGIN_ROOT}/hooks/pre-tool-guard.py\"",
            "statusMessage": "loop-spec tool guards"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/team/cycle-stamp-guard.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/team/route-terminal-guard.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/hooks/team/strategy-rotation.sh\"",
            "statusMessage": "loop-spec strategy rotation"
          }
        ]
      }
    ]
  }
}
