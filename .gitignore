# Feature runtime state lives on refs/loop-spec/state/<slug>.
/.loop-spec/features/*/*
/.loop-spec/worktrees/
.worktrees/
.claude/worktrees/
node_modules/
.DS_Store
*.swp
.env
.env.local
*.log

# generated by hooks/install-bundled-workflows.sh
.claude/workflows/loop-spec-*.js

# generated by tooling; never committed
docs/superpowers/
.loop-spec/learnings.jsonl
# machine-readable result pointer (lib/cycle-result.sh); local telemetry
.loop-spec/last-result.json
.loop-spec/runtime.json
.loop-spec/sessions/
.loop-spec/launcher-result.json
.loop-spec/launcher.lock
.loop-spec/decisions-staging/

# loop-runner runtime state (skills/loop-runner; EXECUTE loop-fleet rung)
.loop/
*-loop-worktrees/

# python bytecode caches (loop-runner test runs)
__pycache__/
*.pyc

# Scratch and inbox: hand-off notes, external feedback dumps, working files.
# Anything here is untracked BY CONSTRUCTION, so a `git add -A` cannot sweep it
# into a commit -- keep external reports and scratch files in inbox/ rather than
# loose at the repo root.
inbox/
